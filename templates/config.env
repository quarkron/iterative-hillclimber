# Loop configuration read by scripts/*.sh (source it, or export in the lane job)
LOOP_DIR=<loop_dir>                      # the loop directory (01_setup.md)
IMAGE=<container image>                  # production image candidates run in
LOCKDIR=$LOOP_DIR/locks                  # GPU locks (gpu_guard.sh)
EXCLUDE_GPUS=""                          # GPUs never to use (e.g. a card with a cooling fault)
GPU_NUMA_MAP="0 0 0 0 1 1 1 1"           # NUMA node of GPU 0..N-1 (nvidia-smi topo -m)
MAX_IDLE_C=50                            # guard: idle temperature limit
WATCH_MAX_C=70; WATCH_MAX_MEM_C=75; WATCH_MAX_W=700   # thermal watchdog trips
